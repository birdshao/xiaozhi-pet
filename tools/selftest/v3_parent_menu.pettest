PETSELFTEST1
# V3-06 parent menu: BOOT + dial press held 5 s opens it, dial up/down
# moves, press edits / flips a switch, long press or 30 s idle leaves.
# The only setting changed is Motion: off, checked, and on again, so the
# board ends with the setting it started with (assumes Motion on, the
# default). The wake-up edit is dropped by the idle exit (never saved).
# Counted from "mark begin" (see tools/selftest_report.py).
# Opening, moving and leaving the menu are not pet interactions:
# expect commits 0
# expect min:PET_PARENT_OPEN 3
# expect min:PET_PARENT_SAVED 2
# expect none:PET_PARENT_SAVE_FAILED 0
# expect none:PET_PARENT_REFUSED 0
# expect min:parent_exit=long 2
# expect min:parent_exit=idle 1
# Gesture while Motion is off: ignored. Back on: the giggle plays.
# expect min:motion_off=1 1
# expect min:name=giggle 1
# expect none:PET_SELFTEST_ABORT 0
# expect selftest_done 1
# expect max_partial_ms 2500
# expect timescale 50
# Quiet prompts while testing (RAM only, this boot).
volume 15
# TEST ONLY: the 30 s idle exit at 50 % (15 s: the 7 s after opening and
# the 1.5 s steps stay well inside it). "twait" scales with it.
# Real speed: timescale 100 (selftest_report.py --timescale 100).
timescale 50
# Start as soon as XiaoZhi is idle (Wi-Fi up, activated), not after a
# fixed 20 s; the pet toggle below still retries.
waitidle 60000
pet
wait 6000
# Normalize restored pet state to "home, neutral".
tap press 6000
hold press 1500 6000
mark begin
# 1) Open (full refresh), walk down to Motion, switch it off, leave.
combo 5500 7000
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap press 3000
hold press 1500 8000
# Motion off: no reaction.
gesture gentle
wait 4000
# 2) Open, edit wake-up (+15 min), then wait out the 30 s idle exit.
combo 5500 5000
tap press 2000
tap up 2000
twait 30000
wait 3000
# 3) Open, Motion back on, leave.
combo 5500 7000
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap down 1500
tap press 3000
hold press 1500 8000
# Motion on again: gentle shake -> giggle.
gesture gentle
wait 6000
pet
wait 4000
end

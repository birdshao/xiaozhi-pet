PETSELFTEST1
# V3-03/V3-04 good morning. The "morning" step takes the RTC-alarm wake path
# without a power cycle: sunrise picture, morning animation, 60 s window.
# 1) A dial touch inside the window keeps TuanTuan awake.
# 2) Nobody touches it: back to sleep (sleep flow, PMIC off). The "alarm"
#    step makes the RTC wake the board 30 s later; that self-test wake skips
#    the morning, so the host can restore the board.
# Counted from "mark begin" (see tools/selftest_report.py).
# expect min:PET_MORNING_WAKE 2
# expect min:PET_MORNING_BEGIN 2
# expect min:name=morning 2
# expect min:PET_MORNING_STAYED 1
# expect min:PET_POWER_SLEEP 1
# expect min:PET_SLEEP_SHOWN 1
# expect min:wake=selftest 1
# expect min:armed=1 1
# expect min:woke_by_alarm=1 1
# expect min:reason=alarm_wake 1
# expect min:reason=selftest_wake 1
# expect none:PET_SLEEP_POWEROFF_RETURNED 0
# expect none:PET_MORNING_FALLBACK 0
# expect none:PET_SELFTEST_ABORT 0
# expect timescale 50
# Quiet prompts while testing (RAM only, this boot).
volume 15
# TEST ONLY: the 60 s morning window (and the power timers) at 50 %, so
# the dial touch below still lands well inside it. "twait" scales with it;
# refreshes, animation and the sleep flow stay real ("wait").
# Real speed: timescale 100 (selftest_report.py --timescale 100).
timescale 50
# Start as soon as XiaoZhi is idle (Wi-Fi up, activated), not after a
# fixed 20 s; the pet toggle below still retries.
waitidle 60000
pet
wait 6000
# Normalize restored pet state to "home, neutral".
tap press 6000
hold press 1500 6000
mark begin
# The morning power-off below must come back: arm the alarm first.
alarm 30
# 1) Morning, then a dial touch: stays awake past the 60 s window.
morning
wait 15000
tap down 6000
twait 50000
# 2) Morning, nobody touches it: sleep after the window, then the sleep
#    flow powers off; the alarm wakes the board 30 s after that.
morning
twait 60000
wait 30000
end

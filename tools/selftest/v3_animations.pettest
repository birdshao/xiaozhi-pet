PETSELFTEST1
# Animations and the relaxed refresh policy, no person needed.
# Counted from "mark begin" (see tools/selftest_report.py).
# expect min:name=greet 1
# expect min:name=feed 1
# expect min:PET_EPD_CLEANUP 1
# expect min:name=blink 1
# expect min:name=sleep_in 1
# expect min:PET_SLEEP_SHOWN 1
# expect min:PET_SLEEP_CANCELLED 1
# expect none:PET_SELFTEST_ABORT 0
# expect selftest_done 1
# expect max_partial_ms 2500
# expect max_full_ms 5000
# expect timescale 25
# Quiet prompts while testing (RAM only, this boot).
volume 15
# TEST ONLY: cleanup (20 s) and blink (45..90 s) timers at 25 %. "twait"
# scales with it; refreshes and animation frames stay real ("wait").
# Real speed: timescale 100 (selftest_report.py --timescale 100).
timescale 25
# Start as soon as XiaoZhi is idle (Wi-Fi up, activated), not after a
# fixed 20 s; the pet toggle below still retries.
waitidle 60000
pet
wait 6000
# Normalize restored pet state to "home, neutral".
tap press 6000
hold press 1500 6000
mark begin
# Chat (0): the pet says hi and waves.
tap up 2500
tap press 6000
# Feed (3): V8 care menu, press the fish; back home: happy face, then hearts.
tap down 2500
tap down 2500
tap down 2500
tap press 6000
tap press 11000
# 40 highlight moves Feed <-> Sleep pass the rail's soft budget without
# a full refresh; 20 s of quiet (scaled) then run one cleanup full refresh.
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
tap down 1500
tap up 1500
twait 20000
wait 6000
# Quiet home screen: an idle blink within 45..90 s (scaled) of the cleanup.
twait 90000
wait 3000
# Sleep (4): Zzz one by one; cancel inside the 3 s window.
tap down 2500
tap press 8000
tap up 6000
pet
wait 5000
end

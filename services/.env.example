# Copy to the working directory as .env. Environment variables override it.
KID_PET_ENV=development
KID_PET_DB=data/pet_learning.sqlite3
KID_PET_ENABLE_PLAYGROUND=0
# Production requires an HTTPS origin, exact reverse-proxy IP, and Fernet key.
KID_PET_PUBLIC_ORIGIN=
KID_PET_TRUSTED_PROXY=
# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KID_PET_TOTP_KEY=
# Optional CLI password input; otherwise create-parent prompts without echo.
# KID_PET_PARENT_PASSWORD=
# Voice service (XiaoZhi child_voice_guard) bearer token for /v1/voice/*; 32-256 chars,
# never a device token. Unset = the voice endpoint rejects every request.
# Generate privately: python -c "import secrets; print(secrets.token_urlsafe(32))"
KID_PET_VOICE_TOKEN=
# IANA timezone used to speak the time (parent-configurable per device from S3).
KID_PET_TIMEZONE=Asia/Shanghai

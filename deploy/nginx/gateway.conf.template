# Internal gateway: one HTTP port, path routing to PetLearning and XiaoZhi. Not a public edge:
# TLS, rate limiting, HSTS and the public allow-list are the operator's ingress (§3.3 N1-N11).
# It repeats the path allow-list (N6) so a mis-configured ingress cannot expose /v1/voice/ etc.

# Honour X-Forwarded-For only from the operator's ingress; otherwise the direct peer is the client.
set_real_ip_from ${INGRESS_PROXY_IP};
real_ip_header X-Forwarded-For;

map $realip_remote_addr $pet_fwd_proto {
    default http;
    ${INGRESS_PROXY_IP} $http_x_forwarded_proto;
}
# /xiaozhi/ota/ hands a signed WebSocket token to any caller at the pinned XiaoZhi commit, so the
# device-facing XiaoZhi routes are rate limited per client address here and again at the ingress.
limit_req_zone $binary_remote_addr zone=xz_ota:1m rate=20r/m;
limit_req_zone $binary_remote_addr zone=xz_ws:1m rate=30r/m;
limit_req_status 429;
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8780;
    server_tokens off;
    client_max_body_size 64k;                    # N7 default
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # single address; client-supplied value dropped
    proxy_set_header X-Forwarded-Proto $pet_fwd_proto;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    access_log off;                              # N11: never log Authorization/Cookie/bodies

    location = /healthz {
        proxy_pass http://pet-learning:8765/healthz;
    }

    location ^~ /v1/devices/ { proxy_pass http://pet-learning:8765; }
    location ^~ /v1/pairing/ { proxy_pass http://pet-learning:8765; }
    location ^~ /parent/     { proxy_pass http://pet-learning:8765; }
    location ^~ /v1/parent/  { proxy_pass http://pet-learning:8765; }

    location ^~ /v1/parent/content {
        client_max_body_size 64m;                # N7 upload limit
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://pet-learning:8765;
    }

    location ^~ /v1/content/packages/ {
        proxy_buffering off;                     # N7: stream, honour Range
        proxy_pass http://pet-learning:8765;
    }

    # XiaoZhi server (own container, fixed address).
    location ^~ /xiaozhi/v1/ {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;                 # N5: >= 120 s idle
        limit_req zone=xz_ws burst=10 nodelay;
        proxy_pass http://172.28.0.20:8000;
    }
    location ^~ /xiaozhi/ota/ {
        limit_req zone=xz_ota burst=10 nodelay;
        proxy_pass http://172.28.0.20:8003;
    }

    # Everything else (/v1/voice/, /play, /docs, /openapi.json, XiaoZhi vision/admin) is not routed.
    location / { return 404; }
}

# Public ingress (§3.3 N1-N12): TLS termination, per-IP rate limits, HSTS and the public path
# allow-list in front of the internal gateway (172.28.0.2:8780). Runs as the `ingress` compose service
# (profile `ingress`), published on 8443; the router forwards WAN TCP 8443 to it.
# ${PET_INGRESS_HOST} comes from deploy/.env. The gateway repeats the allow-list (defence in depth).

# N11: no request body, query string, Authorization or Cookie in the log; rotated daily, 14 days.
log_format pet_ingress '$remote_addr [$time_local] $request_method $uri $status $body_bytes_sent';

limit_req_zone $binary_remote_addr zone=ing_strict:2m rate=30r/m;   # N8: /parent/ and /v1/pairing/
limit_req_zone $binary_remote_addr zone=ing_gen:2m rate=10r/s;      # N8: everything else
limit_req_zone $binary_remote_addr zone=ing_ota:1m rate=20r/m;      # XiaoZhi OTA hands out tokens
limit_req_zone $binary_remote_addr zone=ing_ws:1m rate=30r/m;       # WSS sessions cost ASR/TTS time
limit_req_status 429;
limit_req_log_level warn;   # (the error log below is crit-only: those lines carry the request line)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Anything that is not our host name (scanners hitting the bare IP) gets no certificate at all.
server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name ${PET_INGRESS_HOST};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;                # N2
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ingress_ssl:5m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;   # N9: 365 days, no caching added
    add_header X-Content-Type-Options nosniff always;

    access_log /var/log/nginx/ingress-access.log pet_ingress;
    # N11: nginx error-log lines quote the full request line including the query string (a token may
    # ride in it), so only crit and worse are written; rate-limit and upstream errors are not.
    error_log  /var/log/nginx/ingress-error.log crit;

    client_max_body_size 64k;                     # N7 default
    limit_req zone=ing_gen burst=20 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;      # N4: client-supplied value dropped
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;

    location = /healthz { proxy_pass http://172.28.0.2:8780; }

    location ^~ /v1/devices/ { proxy_pass http://172.28.0.2:8780; }
    location ^~ /v1/pairing/ {
        limit_req zone=ing_strict burst=20 nodelay;
        proxy_pass http://172.28.0.2:8780;
    }
    location ^~ /parent/ {
        limit_req zone=ing_strict burst=20 nodelay;
        proxy_pass http://172.28.0.2:8780;
    }
    location ^~ /v1/parent/ {
        limit_req zone=ing_strict burst=20 nodelay;
        proxy_pass http://172.28.0.2:8780;
    }
    location ^~ /v1/parent/content {
        limit_req zone=ing_strict burst=20 nodelay;
        client_max_body_size 64m;                 # N7 upload limit
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://172.28.0.2:8780;
    }
    location ^~ /v1/content/packages/ {
        proxy_buffering off;                      # N7: stream, honour Range
        proxy_pass http://172.28.0.2:8780;
    }

    location ^~ /xiaozhi/v1/ {
        limit_req zone=ing_ws burst=10 nodelay;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;                  # N5: >= 120 s idle
        proxy_pass http://172.28.0.2:8780;
    }
    location ^~ /xiaozhi/ota/ {
        limit_req zone=ing_ota burst=10 nodelay;
        proxy_pass http://172.28.0.2:8780;
    }

    # N6: everything else (/v1/voice/, /play, /docs, /openapi.json, XiaoZhi vision/admin) is not routed.
    location / { return 404; }
}

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.extra-index-url https://pypi.org/simple && \
    pip config set global.timeout 120
WORKDIR /app
COPY services/requirements.txt services/requirements.txt
RUN pip install --no-cache-dir -r services/requirements.txt
COPY services services
COPY tools/pet_learning_admin.py tools/pet_learning_admin.py
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin pet && mkdir /data /backups && chown pet /data /backups
USER 10001
EXPOSE 8765
CMD ["python", "-m", "uvicorn", "services.pet_learning.api:app", "--host", "0.0.0.0", "--port", "8765", "--no-proxy-headers"]

# Copy to /etc/pet-ingress/lucky.env on the server. Not a secret (the key is a separate file).
LUCKY_SSH=pull@192.168.1.224
LUCKY_SSH_PORT=22
# Paths as seen by the SSH login on the Lucky side (Lucky's "路径映射" lists the export files).
LUCKY_CRT=/goodluck/cert_export/CERT_NAME.crt
LUCKY_KEY=/goodluck/cert_export/CERT_NAME.key

[Unit]
Description=Sync pet.birdshao.cn A record to the current public IPv4 (DNSPod)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# systemd (root) reads the file; the service itself runs as a throwaway user without access to it.
EnvironmentFile=/etc/pet-ingress/dnspod.env
Environment=DDNS_DOMAIN=birdshao.cn DDNS_SUBDOMAIN=pet
ExecStart=/usr/bin/python3 /opt/pet-ingress/pet-ddns.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Copy to deploy/providers.env on the VM (chmod 600). Read by the xiaozhi-server and pet-learning containers.
# One line per setting: XZ__<section>__<module>__<key>=<value>
# Values are text by default (keys like 1e5 or 0123 stay intact); prefix `yaml:` for a typed value,
# e.g. XZ__TTS__EdgeTTS__speed=yaml:1.2
# <section> is ASR, LLM or TTS; <module> and <key> are the names in upstream config.yaml (v0.9.8).
# XZ__LLM__<module>__api_key=
# XZ__LLM__<module>__model_name=
# XZ__ASR__<module>__api_key=
# XZ__TTS__<module>__api_key=
#
# S6 open chat (docs/SERVER_S6.md §5): Zhipu GLM, called by pet-learning. Without the key the
# panel's open-chat switch stays grey. The model line is optional (default glm-4.7-flash).
# KID_PET_GLM_API_KEY=<key from the bigmodel.cn console, e.g. xxxxxxxx.yyyyyyyy>
# KID_PET_GLM_MODEL=glm-4.7-flash

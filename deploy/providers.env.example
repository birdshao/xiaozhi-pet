# Copy to deploy/providers.env on the VM (chmod 600). Read only by the xiaozhi-server container.
# One line per setting: XZ__<section>__<module>__<key>=<value>
# <section> is ASR, LLM or TTS; <module> and <key> are the names in upstream config.yaml (v0.9.8).
# XZ__LLM__<module>__api_key=
# XZ__LLM__<module>__model_name=
# XZ__ASR__<module>__api_key=
# XZ__TTS__<module>__api_key=

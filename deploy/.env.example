# Copy to deploy/.env on the VM (chmod 600) and fill in. Never commit the real file.
# Generate secrets privately, e.g.  python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Public address and ingress (§3.3; configured by the operator) ---------------------------
KID_PET_PUBLIC_ORIGIN=https://pet.example.com:8443
# IP address of YOUR reverse proxy as the VM sees it (N4); X-Forwarded-For is trusted only from it.
KID_PET_TRUSTED_PROXY=192.168.1.1
# Gateway listen address/port on the VM: the VM's LAN address, or 127.0.0.1 if the proxy is local.
PET_GATEWAY_BIND=192.168.1.110
PET_GATEWAY_PORT=8780

# --- Secrets (all private, all required) -----------------------------------------------------
# Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KID_PET_TOTP_KEY=
KID_PET_BACKUP_KEY=
# XiaoZhi device-token signing key (server.auth_key), >= 32 chars
XZ_AUTH_KEY=
# Voice-bridge credentials (child_voice_guard). KID_PET_VOICE_TOKEN signs /v1/voice turns on both
# sides (32-256 chars, separate from every device token); the id pair must match the enrolled pet.
KID_PET_CHILD_MODE=1
KID_PET_UPSTREAM_DEVICE_ID=
KID_PET_BUSINESS_DEVICE_ID=
KID_PET_VOICE_TOKEN=

# --- Voice providers (your choice; keys go here and nowhere else) ----------------------------
# Module names are the keys under ASR / LLM / TTS in upstream config.yaml (v0.9.8).
XZ_ASR_MODULE=SherpaParaformerASR
XZ_LLM_MODULE=ChatGLMLLM
XZ_TTS_MODULE=EdgeTTS
# Per-module settings (API keys etc.) go in deploy/providers.env, see providers.env.example.
